      },
      "cited": [
        "Afternoon nap"
      ]
    }
  },
  {
    "id": "E15",
    "name": "Activity not in knowledge base goes last, flagged, uncited",
    "request": "Build a daily plan for my dog with a swim session from 3 to 4pm",
    "expect": {
      "status": "ok",
      "include": [
        "Swim session"
      ],
      "pinned": {
